* {
    font: "XanhMono 9";
    g-spacing: 4px;
    g-margin: 0;
    b-radius: 0px;
    g-padding: 4px;
    w-border: 0px solid;
    w-border-color: #FFFFFFFF;
    w-padding: 6px;
    icon-theme: "hicolor";
    /* mapped from pywal */
    bg-color:   @background;
    fg-color:   @foreground;
    fgp-color:  @foreground;
    alt-color:  @alternate-normal-background;
    hl-color:   @selected-normal-background;
    hlt-color:  @selected-normal-foreground;
    b-color:    @border-color;
}
configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
}
@import "colors.rasi"
